{
  "name": "qgl-github",
  "version": "0.0.1",
  "description": "Tool to talk to github via GraphQL",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "tsc-watch": "./node_modules/typescript/bin/tsc -w",
    "build": "node ./node_modules/webpack-cli/bin/cli.js --env build --mode=production",
    "build-dashboard": "node ./node_modules/webpack-cli/bin/cli.js --env build --mode=production",
    "start": "node ./node_modules/webpack-cli/bin/cli.js serve --host 0.0.0.0 --mode=development",
    "start-dev-server": "node ./node_modules/webpack-cli/bin/cli.js serve --host 0.0.0.0 --mode=development"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest",
      "^.+\\.js$": ["ts-jest", { "diagnostics": false }]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(uuid|@octokit|@apollo\\/client)/)"
    ],
    "setupFiles": [
      "<rootDir>/config/shim.js",
      "jest-localstorage-mock"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/config/preprocessor_test.js"
    ],
    "testMatch": [
      "**/__tests__/**/*_test.(ts|tsx|js)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,js,tsx}"
    ],
    "testEnvironment": "jest-environment-jsdom-global",
    "testEnvironmentOptions": {
      "url": "http://test.com/unknown"
    },
    "moduleNameMapper": {
      "^@octokit/rest$": "<rootDir>/config/mocks/octokit.js",
      "^react-markdown$": "<rootDir>/config/mocks/react-markdown.js",
      "^remark-gfm$": "<rootDir>/config/mocks/remark-gfm.js",
      "^react-plotly\\.js$": "<rootDir>/config/mocks/react-plotly.js"
    }
  },
  "author": "Christof Sirk",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.5.0",
    "@types/plotly.js": "^1.54.22",
    "@types/qs": "^6.15.0",
    "@types/ramda": "^0.31.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/request": "^2.48.8",
    "@types/request-promise-native": "^1.0.18",
    "@types/uuid": "^11.0.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "html-webpack-plugin": "5.6.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-jsdom-global": "^4.0.0",
    "jest-localstorage-mock": "^2.4.26",
    "path-browserify": "^1.0.1",
    "prettier": "^3.8.1",
    "source-map-loader": "4.0.2",
    "ts-jest": "^29.4.0",
    "ts-loader": "9.5.4",
    "tslint": "^5.20.1",
    "typescript": "^5.9.3",
    "webpack": "5.105.4",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.2"
  },
  "dependencies": {
    "@apollo/client": "^4.1.0",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@octokit/rest": "^22.0.0",
    "apollo3-cache-persist": "^0.15.0",
    "classnames": "^2.5.1",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "github-rebase": "^1.1.0",
    "graphql": "^16.0.0",
    "netlify-auth-providers": "^1.0.0-alpha5",
    "plotly.js": "^1.58.5",
    "qs": "^6.15.0",
    "ramda": "^0.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "request": "^2.88.2",
    "request-promise-native": "^1.0.9",
    "rxjs": "^7.8.0",
    "uuid": "^13.0.0"
  },
  "resolutions": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
