{
  "name": "qgl-github",
  "version": "0.0.1",
  "description": "Tool to talk to github via GraphQL",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "tsc-watch": "./node_modules/typescript/bin/tsc -w",
    "build": "node ./node_modules/webpack-cli/bin/cli.js --env build --mode=production",
    "build-dashboard": "node ./node_modules/webpack-cli/bin/cli.js --env build --mode=production",
    "start": "node ./node_modules/webpack-cli/bin/cli.js serve --host 0.0.0.0 --mode=development",
    "start-dev-server": "node ./node_modules/webpack-cli/bin/cli.js serve --host 0.0.0.0 --mode=development"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest",
      "^.+\\.js$": ["ts-jest", { "diagnostics": false }]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(uuid)/)"
    ],
    "setupFiles": [
      "<rootDir>/config/shim.js",
      "jest-localstorage-mock"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/config/preprocessor_test.js"
    ],
    "testMatch": [
      "**/__tests__/**/*_test.(ts|tsx|js)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,js,tsx}"
    ],
    "testEnvironment": "jest-environment-jsdom-global",
    "testEnvironmentOptions": {
      "url": "http://test.com/unknown"
    },
    "moduleNameMapper": {
      "^react-markdown$": "<rootDir>/config/mocks/react-markdown.js",
      "^remark-gfm$": "<rootDir>/config/mocks/remark-gfm.js"
    }
  },
  "author": "Christof Sirk",
  "license": "MIT",
  "devDependencies": {
    "@types/classnames": "^2.3.4",
    "@types/enzyme": "^3.10.12",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.5.0",
    "@types/plotly.js": "^1.54.22",
    "@types/qs": "^6.15.0",
    "@types/ramda": "^0.31.1",
    "@types/react": "^16.14.34",
    "@types/react-dom": "^16.9.17",
    "@types/react-router-dom": "^5.1.7",
    "@types/request": "^2.48.8",
    "@types/request-promise-native": "^1.0.18",
    "@types/uuid": "^11.0.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.7",
    "graphql-tools": "^4.0.8",
    "html-webpack-plugin": "5.6.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-jsdom-global": "^4.0.0",
    "jest-localstorage-mock": "^2.4.26",
    "path-browserify": "^1.0.1",
    "prettier": "^3.8.1",
    "react-test-renderer": "^16.13.1",
    "source-map-loader": "4.0.2",
    "ts-jest": "^29.4.0",
    "ts-loader": "9.5.4",
    "tslint": "^5.20.1",
    "typescript": "^5.9.3",
    "webpack": "5.105.4",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "4.15.2"
  },
  "dependencies": {
    "@material-ui/core": "^4.11.3",
    "@material-ui/icons": "^4.11.2",
    "@octokit/rest": "^16.43.2",
    "apollo-cache-inmemory": "^1.6.6",
    "apollo-cache-persist": "^0.1.1",
    "apollo-client": "^2.6.10",
    "apollo-link": "^1.2.14",
    "apollo-link-context": "^1.0.20",
    "apollo-link-http": "^1.5.17",
    "classnames": "^2.5.1",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "github-rebase": "^1.1.0",
    "graphql": "^14.7.0",
    "graphql-tag": "2.12.6",
    "netlify-auth-providers": "^1.0.0-alpha5",
    "plotly.js": "^1.58.5",
    "qs": "^6.15.0",
    "ramda": "^0.32.0",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-markdown": "^8.0.0",
    "react-plotlyjs-ts": "^2.2.2",
    "react-router-dom": "^5.2.0",
    "remark-gfm": "^3.0.1",
    "request": "^2.88.2",
    "request-promise-native": "^1.0.9",
    "uuid": "^13.0.0"
  }
}
